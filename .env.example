# Supabase (one project per merchant app)
NEXT_PUBLIC_SUPABASE_URL=
# Safe in the browser as long as row level security is on (it is, for every table).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side only. Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# The address the app is served from, used in sign-in email links. Optional: without it the
# request's own address is used. Add the same address to Supabase's allowed redirect URLs.
APP_URL=

# Set to "demo" only for tests and demo previews: the app then runs on built-in invented
# records and anyone can sign in as a demo staff member. Never set it on a merchant's live app.
APP_DATA=
